{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mailcove",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,

  // Serve the app from your own hostname by uncommenting this block. The zone
  // must live on the same Cloudflare account as the Worker.
  // "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/health"]
  },

  "vars": {
    "APP_NAME": "Mailcove",
    // Public URL of this deployment. Used for auth cookies, webhook URLs and links in notifications.
    "APP_BASE_URL": "http://localhost:5173",
    // Worker name that Cloudflare Email Routing rules should target. Keep equal to "name" above.
    "EMAIL_WORKER_NAME": "mailcove",
    // Default provider for new domains: cloudflare | resend | postmark | sendgrid | mailgun
    "DEFAULT_MAIL_PROVIDER": "cloudflare",
    // Seconds to hold outgoing mail so it can be cancelled ("Undo send").
    "UNDO_SEND_SECONDS": "10"
  },

  // Secrets (set with `wrangler secret put <NAME>`; locally in .dev.vars):
  //   AUTH_SECRET          random 32+ byte string used by better-auth
  //   ENCRYPTION_KEY       base64 32-byte key for encrypting provider credentials at rest
  //   CF_API_TOKEN         Cloudflare token: Zone Read, Email Routing Edit, Email Sending Edit
  //   CF_ACCOUNT_ID        Cloudflare account id (domain onboarding + backups)
  //   RESEND_API_KEY / RESEND_WEBHOOK_SECRET
  //   POSTMARK_SERVER_TOKEN / POSTMARK_ACCOUNT_TOKEN / POSTMARK_WEBHOOK_SECRET
  //   SENDGRID_API_KEY / SENDGRID_WEBHOOK_PUBLIC_KEY
  //   MAILGUN_API_KEY / MAILGUN_WEBHOOK_SIGNING_KEY / MAILGUN_REGION
  //   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
  //   TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY (optional)

  // Locally the binding is simulated (sends are logged, not delivered). Set
  // "remote": true after `wrangler login` to send real mail from `npm run dev`.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailcove",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "mailcove-storage"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "MAIL_HUB", "class_name": "MailHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailHub"] }],

  "queues": {
    "producers": [
      { "binding": "INBOUND_QUEUE", "queue": "mailcove-inbound" },
      { "binding": "OUTBOUND_QUEUE", "queue": "mailcove-outbound" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "mailcove-dlq" }
    ],
    "consumers": [
      {
        "queue": "mailcove-inbound",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "mailcove-dlq"
      },
      {
        "queue": "mailcove-outbound",
        "max_batch_size": 5,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "mailcove-dlq"
      },
      { "queue": "mailcove-dlq", "max_batch_size": 10, "max_batch_timeout": 30 }
    ]
  },

  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SEND_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "SEARCH_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEBHOOK_RATE_LIMITER", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } }
  ],

  "triggers": {
    // every minute: snooze wake-ups, scheduled sends, queued retries
    // daily 03:00 UTC: retention, DNS re-check, backups, session cleanup
    "crons": ["* * * * *", "0 3 * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
